{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "site/**/*.ts",
    "site/**/*.vue",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
